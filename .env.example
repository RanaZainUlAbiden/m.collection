# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Decap CMS GitHub OAuth (for production on Vercel) ───────────
# These are ONLY needed when deploying to Vercel with GitHub backend.
# For local development, Decap CMS uses local_backend mode (no OAuth needed).
#
# To get these values:
# 1. Go to GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# 2. Set Authorization callback URL to: https://your-domain.com/api/decap-auth
# 3. Copy the Client ID and generate a Client Secret
# 4. Set these as Vercel environment variables
OAUTH_GITHUB_CLIENT_ID=your_github_oauth_client_id
OAUTH_GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
OAUTH_REDIRECT_URI=https://your-domain.com/api/decap-auth